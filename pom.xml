<?xml version="1.0" encoding="UTF-8"?>
<!-- XiHan Framework SDK for Java：整个 SDK 是一个构件，原语、清单、调用上下文、管道、操作与插件运行时按 Java 包划分 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.xihanfun</groupId>
  <artifactId>xihan-framework</artifactId>
  <version>0.2.0-rc.1</version>

  <name>XiHan Framework SDK for Java</name>
  <description>XiHan Framework Spec 的 Java 实现：原语、清单、调用上下文、管道、操作契约与进程外插件运行时。</description>
  <url>https://github.com/XiHanFun/framework-sdk-java</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <organization>
    <name>XiHanFun</name>
    <url>https://github.com/XiHanFun</url>
  </organization>

  <!-- Maven Central 要求写明开发者；这里只写组织，不写个人 -->
  <developers>
    <developer>
      <id>xihanfun</id>
      <name>XiHanFun</name>
      <url>https://github.com/XiHanFun</url>
      <organization>XiHanFun</organization>
      <organizationUrl>https://github.com/XiHanFun</organizationUrl>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/XiHanFun/framework-sdk-java</url>
    <connection>scm:git:https://github.com/XiHanFun/framework-sdk-java.git</connection>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <jackson.version>2.22.4</jackson.version>
    <junit.version>6.1.3</junit.version>
    <!-- 插件运行时（com.xihanfun.framework.plugin）的可选依赖；生成代码的 protoc 与 protoc-gen-grpc-java 取同一版本 -->
    <grpc.version>1.85.1</grpc.version>
    <protobuf.version>4.36.2</protobuf.version>

    <maven-clean-plugin.version>3.4.1</maven-clean-plugin.version>
    <maven-resources-plugin.version>3.4.0</maven-resources-plugin.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-site-plugin.version>3.21.0</maven-site-plugin.version>
    <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
    <protobuf-maven-plugin.version>5.1.12</protobuf-maven-plugin.version>
    <!-- 发布到 Maven Central（release 配置）：源码包、Javadoc 包、GPG 签名与 Central Portal 上传 -->
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- grpc-protobuf 传递的是 protobuf-java 3.x；生成代码是 4.x 的，运行时不能低于它 -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-bom</artifactId>
        <version>${protobuf.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- XGI 载荷、清单读取与原语的线上编码都经 Jackson；原语核心类型本身不引用它 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- 插件运行时的传输：只有写进程外插件的应用需要，自己加进依赖（optional，不传递）；其余包不引用它们 -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- 示例插件 echo 随测试编译（同一套门禁），一致性测试从测试类路径启动它；示例不进构件 -->
    <testResources>
      <testResource>
        <directory>${project.basedir}/examples/echo/src/main/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compileSourceRoots>
                <compileSourceRoot>${project.basedir}/src/test/java</compileSourceRoot>
                <compileSourceRoot>${project.basedir}/examples/echo/src/main/java</compileSourceRoot>
              </compileSourceRoots>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <!-- 门禁：全部 lint 警告视为错误；doclint 核对 Javadoc 的语法与引用，缺少 @param 不报 -->
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
              <arg>-Xdoclint:all,-missing</arg>
            </compilerArgs>
            <showWarnings>true</showWarnings>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- 测试在类路径上运行：Jackson 要反射测试里的请求类型，模块路径上需要逐包 opens；模块边界由编译期的 module-info 核对 -->
            <useModulePath>false</useModulePath>
            <systemPropertyVariables>
              <!-- 一致性向量按仓库根的相对路径读取（spec/conformance/vectors） -->
              <xihan.repository.root>${project.basedir}</xihan.repository.root>
              <xihan.project.version>${project.version}</xihan.project.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      重新生成插件协议的 Java 代码：mvn -Pprotocol process-sources（Docker 命令见 .agents/skills/testing-release/references/docker.md）。
      spec/plugin/plugin.proto 没有 Java 选项，先复制一份、在末尾补上 java_package 等文件选项，再以 protoc 与
      protoc-gen-grpc-java（都从 Maven Central 取，版本即 protobuf.version 与 grpc.version）生成，
      最后整个替换 src/main/java/com/xihanfun/framework/plugin/v1。生成物提交进仓库，CI 重新生成后核对没有差异。
    -->
    <profile>
      <id>protocol</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>${maven-antrun-plugin.version}</version>
            <executions>
              <execution>
                <id>protocol-source</id>
                <phase>initialize</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <delete dir="${project.build.directory}/protocol"/>
                    <concat destfile="${project.build.directory}/protocol/source/plugin/plugin.proto" encoding="UTF-8" outputencoding="UTF-8" fixlastline="yes">
                      <fileset file="${project.basedir}/spec/plugin/plugin.proto"/>
                      <footer>
// 以下选项由 framework-sdk-java 的 protocol 配置追加，规范的 plugin.proto 不含它们
option java_package = "com.xihanfun.framework.plugin.v1";
option java_outer_classname = "PluginProto";
</footer>
                    </concat>
                  </target>
                </configuration>
              </execution>
              <execution>
                <id>protocol-copy</id>
                <phase>process-sources</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <delete dir="${project.basedir}/src/main/java/com/xihanfun/framework/plugin/v1"/>
                    <copy todir="${project.basedir}/src/main/java">
                      <fileset dir="${project.build.directory}/protocol/java"/>
                    </copy>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>io.github.ascopes</groupId>
            <artifactId>protobuf-maven-plugin</artifactId>
            <version>${protobuf-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>protocol-generate</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <protoc>${protobuf.version}</protoc>
                  <sourceDirectories>
                    <sourceDirectory>${project.build.directory}/protocol/source</sourceDirectory>
                  </sourceDirectories>
                  <outputDirectory>${project.build.directory}/protocol/java</outputDirectory>
                  <registerAsCompilationRoot>false</registerAsCompilationRoot>
                  <ignoreProjectDependencies>true</ignoreProjectDependencies>
                  <incrementalCompilation>false</incrementalCompilation>
                  <embedSourcesInClassOutputs>false</embedSourcesInClassOutputs>
                  <plugins>
                    <plugin kind="binary-maven">
                      <groupId>io.grpc</groupId>
                      <artifactId>protoc-gen-grpc-java</artifactId>
                      <version>${grpc.version}</version>
                    </plugin>
                  </plugins>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      发布到 Maven Central：mvn -Prelease -DskipTests deploy（由 .github/workflows/release.yml 在推送版本标签后执行）。
      Central 要求每个构件都带源码包、Javadoc 包与 GPG 签名；上传走 Central Portal（central.sonatype.com），
      凭据在 settings.xml 的 server central 里，GPG 口令取环境变量 MAVEN_GPG_PASSPHRASE。
      本地只想看产物时加 -Dgpg.skip 跳过签名。
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <configuration>
              <!-- 与编译期的 doclint 同一口径：核对语法与引用，缺少 @param 不报 -->
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- 口令只从环境变量 MAVEN_GPG_PASSPHRASE 取，不写进 settings.xml 或命令行 -->
                  <bestPractices>true</bestPractices>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- 校验通过即发布，并等到 Central 确认已发布：工作流结束时版本已经能取到 -->
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
