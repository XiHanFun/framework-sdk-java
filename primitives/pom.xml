<?xml version="1.0" encoding="UTF-8"?>
<!-- 原语层（RFC-0001）：核心类型零依赖；JSON 编码在 primitives.json 包里，Jackson 是可选依赖 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.xihanfun</groupId>
    <artifactId>xihan-framework-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>xihan-framework-primitives</artifactId>
  <name>XiHan Framework Primitives</name>
  <description>原语层：Error 与错误码、Result、Maybe、类型化标识、生命周期、管道阶段、稳定性、Baggage 键与消息原语。</description>

  <dependencies>
    <!-- 可选：只有 com.xihanfun.framework.primitives.json 用到；不用 JSON 编码的使用者不必引入 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
